<idea-plugin>
    <id>com.ejsng.ejs-angularjs-navigator</id>
    <name>EJS + AngularJS Navigator</name>
    <vendor>local</vendor>

    <description><![CDATA[
      Tracks variables and functions between EJS templates and AngularJS 1.x controllers.
      Go-to-definition from {{ expressions }} to $scope, find-usages back from a
      controller out to its templates, and detection of unused controllers/directives/filters.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.ejsng.intellij.EjsNgStartupActivity"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="ejsng"
                name="EJS + AngularJS"
                factoryClass="com.ejsng.intellij.EjsNgLanguageServerFactory">
            <description><![CDATA[Language server for EJS + AngularJS 1.x]]></description>
        </server>
        <!--
          NOTE: do NOT use <languageMapping language="JavaScript"/>.

          The "JavaScript" language ID only exists when the JavaScript plugin is present,
          and that plugin isn't bundled with every IDE variant (IDEA Community before
          2026.1, Android Studio). When it's missing, the mapping silently does nothing
          and the plugin looks broken. Matching by FILE NAME instead works on every variant.
        -->
        <fileNamePatternMapping patterns="*.js"  serverId="ejsng" languageId="javascript"/>
        <fileNamePatternMapping patterns="*.ejs" serverId="ejsng" languageId="html"/>
        <languageMapping language="HTML" serverId="ejsng" languageId="html"/>
    </extensions>
</idea-plugin>
