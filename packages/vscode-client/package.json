{
  "name": "ejs-angularjs-navigator",
  "displayName": "EJS + AngularJS Navigator",
  "description": "Tracks variables/functions between EJS templates and AngularJS 1.x controllers",
  "version": "0.2.3",
  "publisher": "phule",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:html",
    "workspaceContains:**/*.ejs"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ejsngPanel",
          "title": "EJS/NG Runtime",
          "icon": "media/runtime-icon.svg"
        }
      ]
    },
    "views": {
      "ejsngPanel": [
        {
          "id": "ejsngRuntimeView",
          "name": "Runtime Log",
          "type": "webview",
          "contextualTitle": "EJS/NG Runtime"
        }
      ]
    },
    "languages": [
      {
        "id": "ejs",
        "aliases": [
          "EJS"
        ],
        "extensions": [
          ".ejs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "ejsng.reindex",
        "title": "EJS/NG: Reindex Workspace"
      },
      {
        "command": "ejsng.showStats",
        "title": "EJS/NG: Show Index Stats"
      },
      {
        "command": "ejsng.connectRuntime",
        "title": "EJS/NG: Connect to Runtime"
      },
      {
        "command": "ejsng.disconnectRuntime",
        "title": "EJS/NG: Disconnect Runtime"
      }
    ],
    "configuration": {
      "title": "EJS + AngularJS Navigator",
      "properties": {
        "ejsng.include": {
          "type": "array",
          "default": [
            "**/*.js",
            "**/*.ejs",
            "**/*.html"
          ],
          "description": "Glob patterns for files to index."
        },
        "ejsng.exclude": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/bower_components/**",
            "**/dist/**",
            "**/*.min.js"
          ],
          "description": "Glob patterns to exclude."
        },
        "ejsng.moduleAliases": {
          "type": "array",
          "default": [
            "myApp",
            "app",
            "appModule"
          ],
          "description": "Variable names treated as an Angular module when no angular.module() declaration is found in the same file."
        },
        "ejsng.ejsDelimiter": {
          "type": "string",
          "default": "%",
          "description": "EJS delimiter. '%' means <% %>."
        },
        "ejsng.customDirectives": {
          "type": "object",
          "default": {},
          "description": "Custom directives -> expression kind. Example: {\"myOn\":\"statement\"}."
        },
        "ejsng.diagnostics.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enables warnings for variables that don't exist on scope. Defaults to OFF to avoid false positives on legacy code."
        },
        "ejsng.runtimeLog.pathMappings": {
          "type": "array",
          "default": [],
          "description": "Maps a container-internal path to its path on this machine, for inline runtime log from a Dockerized process (e.g. [{\"remote\": \"/app\", \"local\": \"/Users/me/project\"}]). Not needed for a process running directly on this machine.",
          "items": {
            "type": "object",
            "required": ["remote", "local"],
            "properties": {
              "remote": { "type": "string", "description": "Path prefix as reported by the container, e.g. /app" },
              "local": { "type": "string", "description": "The matching path on this machine, e.g. /Users/me/project" }
            }
          }
        },
        "ejsng.runtimeLog.chromeExecutablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Chrome/Edge executable used by the activity-bar panel's 'Launch Chrome debug' button. Empty = guess a default install location for this OS.\n\n- macOS: `/Applications/Google Chrome.app/Contents/MacOS/Google Chrome`\n- Windows: `C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe`"
        },
        "ejsng.runtimeLog.chromeDebugPort": {
          "type": "number",
          "default": 9222,
          "description": "Default --remote-debugging-port used by the activity-bar panel's 'Launch Chrome debug' button and pre-filled into its Connect field."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  },
  "scripts": {
    "compile": "tsc --build && node build.js",
    "watch": "tsc --build --watch & node build.js --watch",
    "package": "tsc --build && node build.js --production && npx --yes @vscode/vsce package --no-dependencies"
  }
}